{} => totals
for mode in ["raw", "normalised"]:
    fresh(mode) => gs
    0 => total_merges
    0 => total_manu
    0 => first_manu
    0 => later_manu
    1 => sweep
    1 => working
    while working == 1:
        one_sweep(gs, mode) => r
        r[0] => gs
        total_merges + r[1] => total_merges
        total_manu + r[2] => total_manu
        if sweep == 1:
