0 => disagreements
0 => agreements
0 => cells
0 => p
while p < len(PAIRS):
    PAIRS[p][0] => a
    PAIRS[p][1] => b
    0 => i
    while i < len(FIELDS):
        classify(a, b, i) => cls
        cells + 1 => cells
        if cls == "gap":
            gaps + 1 => gaps
        elif cls == "disagree":
            disagreements + 1 => disagreements
        elif cls == "agree":
