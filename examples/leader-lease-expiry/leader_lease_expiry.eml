        sweep(skew, best) => r
        "" => note
        if best * 2 == skew:
            "   = skew/2, and the gap it creates is 0" => note
        ("  skew %-3d smallest guard with no overlap: %-3d  gap: %d%s" % (skew, best, r[1], note))^0

