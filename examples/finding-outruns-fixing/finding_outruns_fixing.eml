# ---- which findings are left open under each ----

def open_at_end(policy):
    [] => open_ids
    for p in [1:horizon]:
        for f in findings:
            if f[1] == p:
                open_ids + [f[0]] => open_ids
        [] => picked
        if policy == "fifo":
            pick_fifo(open_ids) => picked
        else:
            pick_by_harm(open_ids) => picked
        [] => still
        for o in open_ids:
            if not (o in picked):
                still + [o] => still
        still => open_ids
    return open_ids

open_at_end("fifo") => left_fifo
