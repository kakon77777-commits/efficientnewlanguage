counts([0, 1, 2]) => first
counts([2, 1, 0]) => last
"the headline under two orderings" ^0
"  'our biggest category is security, at " + str(first[0]) + "'" ^0
"  'our biggest category is usability, at " + str(last[2]) + "'" ^0
