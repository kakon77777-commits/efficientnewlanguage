0.0 => worst
0 => i
for r in readings:
    deviation(r, target) => d
    if within_tolerance(r, target, tolerance) == 1:
        "  reading " + str(i) + ": " + str(r) + "  off by " + str(d) + "  ok" => line
    else:
        "  reading " + str(i) + ": " + str(r) + "  off by " + str(d) + "  OUT" => line
    line^0
    passing + within_tolerance(r, target, tolerance) => passing
    if d > worst:
        d => worst
        i => worst_index
    i + 1 => i

