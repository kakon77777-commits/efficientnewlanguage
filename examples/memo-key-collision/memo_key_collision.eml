# ---------------------------------------------------- the separator's own bug
# The separator survives integers and dies on strings that contain it. A key
# scheme that is correct only for the argument types you happened to test is
# not a key scheme.
{} => cache_sep2
{} => cache_len2

def plain_s(a, b):
    return len(a) * 100 + len(b) * 10 + len(a + b)

def memo_sep_s(a, b):
    a + "|" + b => k
    if k in cache_sep2:
        return cache_sep2[k]
    plain_s(a, b) => v
    v => cache_sep2[k]
    return v

def memo_len_s(a, b):
    str(len(a)) + ":" + a + str(len(b)) + ":" + b => k
    if k in cache_len2:
        return cache_len2[k]
    plain_s(a, b) => v
    v => cache_len2[k]
    return v

