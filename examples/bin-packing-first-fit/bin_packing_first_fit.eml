while b < len(remaining):
    contents^+[]
    0 => i
    while i < len(sizes):
        if assignment[i] == b:
            contents + [sizes[i]] => contents
        i + 1 => i
    "  bin " + str(b) + ": " + str(contents) + " (" + str(remaining[b]) + " unused)" => line
    line^0
    b + 1 => b

"First-fit used " + str(len(remaining)) + " bins" => msg3
msg3^0
